            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "last_name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "gender": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female"
                    ]
                  },
                  "date_of_birth": {
                    "type": "string",
                    "format": "date"
                  },
                  "country_of_birth": {
                    "type": "number"
                  },
                  "phone_number": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "occupation": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "residential_address": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "province": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "country_of_city": {
                    "type": "number"
                  },
                  "passport_number": {
                    "type": "string",
                    "maxLength": 45
                  },
                  "issue_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "expire_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "intended_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "country_of_passport": {
                    "type": "number"
                  },
                  "visa_type": {
                    "type": "number"
                  },
                  "vehicle": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "purpose_of_trip": {
                    "type": "number"
                  },
                  "address_during_visit": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "next_destination": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "signature_key": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "upload_file_photo": {
                    "type": "string"
                  },
                  "upload_file_passport": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application updated"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
