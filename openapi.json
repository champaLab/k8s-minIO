              "schema": {
                "type": "object",
                "required": [
                  "application_id",
                  "signature_key"
                ],
                "properties": {
                  "application_id": {
                    "type": "string",
                    "minLength": 7,
                    "maxLength": 10
                  },
                  "signature_key": {
                    "type": "string",
                    "maxLength": 255
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment processed"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
